<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>捷媖教練 · 課程預約系統</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=DM+Serif+Display&display=swap" rel="stylesheet">
    <style>
        :root {
            --teal: #00838f;
            --teal-dark: #005f6b;
            --teal-light: #e0f4f6;
            --teal-mid: #b2e4ea;
            --bg: #f0f6f7;
            --white: #ffffff;
            --text: #1a2e30;
            --text-muted: #607c80;
            --border: #cde5e8;
            --danger: #d32f2f;
            --danger-bg: #ffebee;
            --success: #2e7d32;
            --success-bg: #e8f5e9;
            --warning: #e65100;
            --warning-bg: #fff3e0;
            --radius: 14px;
            --radius-sm: 8px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Noto Sans TC', sans-serif;
            background: var(--bg);
            color: var(--text);
            padding-bottom: 80px;
            min-height: 100vh;
        }

        /* ── Header ── */
        .header {
            background: var(--teal);
            background: linear-gradient(135deg, #005f6b 0%, #00838f 60%, #00a0ae 100%);
            color: white;
            padding: 20px 20px 24px;
            position: relative;
            overflow: hidden;
        }
        .header::before {
            content: '';
            position: absolute;
            top: -30px; right: -30px;
            width: 120px; height: 120px;
            border-radius: 50%;
            background: rgba(255,255,255,0.06);
        }
        .header::after {
            content: '';
            position: absolute;
            bottom: -20px; left: 30%;
            width: 80px; height: 80px;
            border-radius: 50%;
            background: rgba(255,255,255,0.04);
        }
        .header h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 22px;
            font-weight: 400;
            letter-spacing: 0.5px;
        }
        .header-sub {
            font-size: 13px;
            opacity: 0.85;
            margin-top: 4px;
        }
        .user-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255,255,255,0.18);
            border-radius: 20px;
            padding: 4px 12px;
            font-size: 12px;
            margin-top: 10px;
        }

        /* ── Nav ── */
        .nav-bar {
            position: fixed;
            bottom: 0;
            width: 100%;
            max-width: 500px;
            left: 50%;
            transform: translateX(-50%);
            background: white;
            display: flex;
            border-top: 1px solid var(--border);
            height: 64px;
            z-index: 100;
            box-shadow: 0 -4px 16px rgba(0,131,143,0.08);
        }
        .nav-item {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            cursor: pointer;
            color: var(--text-muted);
            gap: 4px;
            transition: color 0.2s;
        }
        .nav-item.active { color: var(--teal); font-weight: 700; }
        .nav-icon {
            width: 22px;
            height: 22px;
            fill: currentColor;
        }

        /* ── Pages ── */
        .container { padding: 16px; max-width: 500px; margin: auto; }
        .page { display: none; }
        .page.active { display: block; }

        /* ── Cards ── */
        .card {
            background: var(--white);
            border-radius: var(--radius);
            padding: 16px;
            margin-bottom: 14px;
            border: 1px solid var(--border);
            box-shadow: 0 1px 4px rgba(0,131,143,0.04);
        }
        .card-title {
            font-size: 15px;
            font-weight: 700;
            color: var(--teal-dark);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* ── Login ── */
        #login-page {
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-height: 100vh;
            padding: 30px 24px;
            background: linear-gradient(160deg, #e0f4f6 0%, #f0f6f7 50%);
        }
        .login-logo {
            text-align: center;
            margin-bottom: 32px;
        }
        .login-logo h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 32px;
            color: var(--teal-dark);
            font-weight: 400;
        }
        .login-logo p { color: var(--text-muted); font-size: 14px; margin-top: 6px; }
        .login-card {
            background: white;
            border-radius: 20px;
            padding: 28px;
            border: 1px solid var(--border);
            box-shadow: 0 8px 32px rgba(0,131,143,0.1);
        }
        .form-group { margin-bottom: 14px; }
        .form-group label { display: block; font-size: 12px; color: var(--text-muted); font-weight: 700; margin-bottom: 5px; letter-spacing: 0.5px; text-transform: uppercase; }
        .form-input {
            width: 100%;
            padding: 12px 14px;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm);
            font-family: 'Noto Sans TC', sans-serif;
            font-size: 14px;
            color: var(--text);
            background: var(--bg);
            outline: none;
            transition: border-color 0.2s;
        }
        .form-input:focus { border-color: var(--teal); background: white; }
        .btn-primary {
            width: 100%;
            padding: 14px;
            background: var(--teal);
            color: white;
            border: none;
            border-radius: var(--radius-sm);
            font-family: 'Noto Sans TC', sans-serif;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            margin-top: 8px;
            transition: background 0.2s, transform 0.1s;
        }
        .btn-primary:active { transform: scale(0.98); }
        .btn-primary:hover { background: var(--teal-dark); }

        /* ── Date picker ── */
        .date-section {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 16px;
        }
        .date-label { font-size: 13px; color: var(--text-muted); white-space: nowrap; }
        .date-input {
            flex: 1;
            padding: 10px 12px;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm);
            font-family: 'Noto Sans TC', sans-serif;
            font-size: 14px;
            color: var(--text);
            background: white;
            outline: none;
        }
        .date-input:focus { border-color: var(--teal); }

        /* ── Time slots ── */
        .coach-range {
            background: var(--teal-light);
            border: 1px solid var(--teal-mid);
            border-radius: var(--radius-sm);
            padding: 10px 14px;
            font-size: 13px;
            color: var(--teal-dark);
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 500;
        }

        /* 剩餘時段視覺化 */
        .timeline-wrap {
            margin-bottom: 16px;
        }
        .timeline-label { font-size: 12px; color: var(--text-muted); margin-bottom: 6px; font-weight: 500; }
        .timeline-bar {
            height: 28px;
            background: #e8e8e8;
            border-radius: 6px;
            overflow: hidden;
            display: flex;
            position: relative;
        }
        .timeline-booked {
            background: #ffcdd2;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            color: #c62828;
            overflow: hidden;
            white-space: nowrap;
            font-weight: 500;
        }
        .timeline-clean {
            background: #ffe0b2;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            color: #e65100;
            overflow: hidden;
            white-space: nowrap;
            font-weight: 700;
        }
        .timeline-free {
            background: #b2e4ea;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            color: var(--teal-dark);
            overflow: hidden;
            white-space: nowrap;
            font-weight: 500;
        }
        .time-axis {
            display: flex;
            justify-content: space-between;
            font-size: 10px;
            color: var(--text-muted);
            margin-top: 3px;
        }

        /* 選擇時段 */
        .slot-picker {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 12px;
        }
        .slot-picker select {
            padding: 10px 12px;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm);
            font-family: 'Noto Sans TC', sans-serif;
            font-size: 14px;
            color: var(--text);
            background: white;
            outline: none;
            width: 100%;
        }
        .slot-picker select:focus { border-color: var(--teal); }
        .slot-picker label { display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 4px; font-weight: 700; }

        /* 已預約時段列表 */
        .booked-section {
            margin-top: 14px;
        }
        .booked-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            background: var(--warning-bg);
            border-radius: var(--radius-sm);
            margin-bottom: 6px;
            border: 1px solid #ffe0b2;
        }
        .booked-dot {
            width: 8px; height: 8px;
            border-radius: 50%;
            background: #e65100;
            flex-shrink: 0;
        }
        .booked-time { font-size: 13px; font-weight: 700; color: var(--warning); }
        .booked-who { font-size: 12px; color: var(--text-muted); }
        .booked-mine { border-color: #b3e5fc; background: #e1f5fe; }
        .booked-mine .booked-dot { background: #0277bd; }
        .booked-mine .booked-time { color: #01579b; }

        /* ── My bookings ── */
        .booking-card {
            background: white;
            border-radius: var(--radius);
            padding: 14px 16px;
            margin-bottom: 12px;
            border: 1px solid var(--border);
            position: relative;
        }
        .booking-date {
            font-size: 14px;
            font-weight: 700;
            color: var(--teal-dark);
        }
        .booking-time {
            font-size: 22px;
            font-weight: 700;
            color: var(--text);
            margin: 4px 0;
            font-family: 'DM Serif Display', serif;
        }
        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.3px;
        }
        .badge-pending { background: var(--warning-bg); color: var(--warning); }
        .badge-confirmed { background: var(--success-bg); color: var(--success); }

        .action-row {
            display: flex;
            gap: 8px;
            margin-top: 12px;
        }
        .btn-cancel {
            flex: 1;
            padding: 8px;
            border: 1.5px solid var(--danger);
            background: none;
            color: var(--danger);
            border-radius: var(--radius-sm);
            font-size: 13px;
            font-family: 'Noto Sans TC', sans-serif;
            cursor: pointer;
            font-weight: 700;
        }
        .btn-edit {
            flex: 1;
            padding: 8px;
            border: 1.5px solid var(--teal);
            background: none;
            color: var(--teal);
            border-radius: var(--radius-sm);
            font-size: 13px;
            font-family: 'Noto Sans TC', sans-serif;
            cursor: pointer;
            font-weight: 700;
        }

        /* ── Modal ── */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,50,60,0.45);
            z-index: 200;
            display: flex;
            align-items: flex-end;
            justify-content: center;
            display: none;
        }
        .modal-overlay.show { display: flex; }
        .modal-box {
            background: white;
            border-radius: 20px 20px 0 0;
            padding: 24px;
            width: 100%;
            max-width: 500px;
        }
        .modal-title { font-size: 17px; font-weight: 700; color: var(--teal-dark); margin-bottom: 16px; }
        .modal-actions { display: flex; gap: 10px; margin-top: 16px; }
        .btn-outline {
            flex: 1;
            padding: 12px;
            border: 1.5px solid var(--border);
            background: none;
            color: var(--text-muted);
            border-radius: var(--radius-sm);
            font-family: 'Noto Sans TC', sans-serif;
            font-size: 14px;
            cursor: pointer;
        }
        .btn-confirm {
            flex: 1;
            padding: 12px;
            background: var(--teal);
            color: white;
            border: none;
            border-radius: var(--radius-sm);
            font-family: 'Noto Sans TC', sans-serif;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
        }

        /* ── Empty / loading ── */
        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-muted);
        }
        .empty-state svg { width: 48px; height: 48px; opacity: 0.3; margin-bottom: 12px; }
        .loading { text-align: center; padding: 30px; color: var(--text-muted); font-size: 14px; }
        .dot-anim::after { content: '...'; animation: dots 1.2s infinite; }
        @keyframes dots {
            0% { content: '.'; }
            33% { content: '..'; }
            66% { content: '...'; }
        }

        /* ── Toast ── */
        .toast {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%) translateY(-80px);
            background: var(--teal-dark);
            color: white;
            padding: 12px 20px;
            border-radius: 30px;
            font-size: 13px;
            font-weight: 700;
            z-index: 999;
            transition: transform 0.3s ease;
            white-space: nowrap;
        }
        .toast.show { transform: translateX(-50%) translateY(0); }

        /* ── Profile ── */
        .profile-avatar {
            width: 64px; height: 64px;
            border-radius: 50%;
            background: var(--teal);
            color: white;
            font-size: 24px;
            font-family: 'DM Serif Display', serif;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 12px;
        }
        .profile-name { text-align: center; font-size: 20px; font-weight: 700; color: var(--teal-dark); }
        .profile-sub { text-align: center; font-size: 13px; color: var(--text-muted); margin-top: 4px; }
        .stat-row { display: flex; gap: 12px; margin-top: 16px; }
        .stat-card {
            flex: 1;
            background: var(--teal-light);
            border-radius: var(--radius-sm);
            padding: 14px;
            text-align: center;
        }
        .stat-num { font-size: 28px; font-weight: 700; color: var(--teal-dark); font-family: 'DM Serif Display', serif; }
        .stat-label { font-size: 12px; color: var(--teal-dark); opacity: 0.7; margin-top: 2px; }
        .logout-btn {
            width: 100%;
            padding: 12px;
            margin-top: 20px;
            border: 1.5px solid var(--border);
            background: none;
            color: var(--text-muted);
            border-radius: var(--radius-sm);
            font-family: 'Noto Sans TC', sans-serif;
            font-size: 14px;
            cursor: pointer;
        }


        /* ── Weekly booking / lessons ── */
        .helper-text { font-size: 12px; color: var(--text-muted); line-height: 1.6; margin-top: 8px; }
        .weekly-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .weekly-grid .full { grid-column: 1 / -1; }
        .mini-btn {
            width: 100%; padding: 11px; border: 1.5px solid var(--teal); background: var(--white);
            color: var(--teal); border-radius: var(--radius-sm); font-family: 'Noto Sans TC', sans-serif;
            font-size: 14px; font-weight: 700; cursor: pointer; margin-top: 10px;
        }
        .lesson-summary {
            display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 14px;
        }
        .lesson-pill {
            background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-sm);
            padding: 10px; text-align: center;
        }
        .lesson-pill strong { display: block; font-size: 22px; color: var(--teal-dark); font-family: 'DM Serif Display', serif; }
        .lesson-pill span { font-size: 11px; color: var(--text-muted); }
        .lesson-list { display: grid; gap: 8px; }
        .lesson-row {
            display: grid; grid-template-columns: 52px 1fr auto; gap: 10px; align-items: center;
            padding: 11px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--white);
            cursor: pointer; transition: transform 0.12s, border-color 0.2s;
        }
        .lesson-row:active { transform: scale(0.99); }
        .lesson-row:hover { border-color: var(--teal-mid); }
        .lesson-no { font-weight: 700; color: var(--teal-dark); font-size: 13px; }
        .lesson-main { font-size: 13px; color: var(--text); }
        .lesson-sub { font-size: 11px; color: var(--text-muted); margin-top: 2px; }
        .lesson-empty { color: var(--text-muted); }
        .detail-line { font-size: 13px; color: var(--text); margin-bottom: 8px; line-height: 1.5; }
        .detail-line strong { color: var(--teal-dark); }
        .btn-danger-fill {
            flex: 1; padding: 12px; background: var(--danger); color: white; border: none;
            border-radius: var(--radius-sm); font-family: 'Noto Sans TC', sans-serif; font-size: 14px; font-weight: 700; cursor: pointer;
        }
    </style>
</head>
<body>

<div class="toast" id="toast"></div>

<!-- Login -->
<div id="login-page">
    <div class="login-logo">
        <h1>捷媖教練</h1>
        <p>課程預約系統</p>
    </div>
    <div class="login-card">
        <div class="form-group">
            <label>帳號（大寫S+手機號碼）</label>
            <input class="form-input" type="text" id="u" placeholder="請輸入帳號" autocomplete="username">
        </div>
        <div class="form-group">
            <label>密碼（預設1234）</label>
            <input class="form-input" type="password" id="p" placeholder="請輸入密碼" autocomplete="current-password">
        </div>
        <button class="btn-primary" onclick="login()">登入</button>
    </div>
</div>

<!-- Main App (hidden until login) -->
<div id="app" style="display:none;">
    <div class="header">
        <h1>捷媖教練</h1>
        <p class="header-sub">學員預約系統</p>
        <div class="user-chip" id="user-chip"></div>
    </div>

    <!-- 預約課程 -->
    <div id="book-page" class="page container">
        <div class="card">
            <div class="card-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;">
                    <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                選擇日期
            </div>
            <div class="date-section">
                <span class="date-label">預約日期</span>
                <input class="date-input" type="date" id="searchDate" onchange="loadAvailableSlots()">
            </div>
        </div>
        <div id="available-slots"></div>
        <button class="logout-btn" onclick="logout()">登出</button>
    </div>

    <!-- 我的課程 -->
    <div id="my-page" class="page container">
        <div id="lesson-summary"></div>
        <div id="lesson-table"></div>
    </div>

    <nav class="nav-bar" id="nav">
        <div class="nav-item active" id="nav-book" onclick="showPage('book')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="nav-icon"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            預約課程
        </div>
        <div class="nav-item" id="nav-my" onclick="showPage('my')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="nav-icon"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
            我的課程
        </div>

    </nav>
</div>


<!-- Lesson Detail Modal -->
<div class="modal-overlay" id="lesson-detail-modal">
    <div class="modal-box">
        <div class="modal-title" id="lesson-detail-title">課程明細</div>
        <div id="lesson-detail-body"></div>
        <div class="modal-actions" id="lesson-detail-actions">
            <button class="btn-outline" onclick="closeLessonDetail()">關閉</button>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal-overlay" id="edit-modal">
    <div class="modal-box">
        <div class="modal-title">修改預約時段</div>
        <p style="font-size:13px;color:var(--text-muted);margin-bottom:14px;" id="edit-date-label"></p>
        <div class="slot-picker">
            <div>
                <label>開始時間</label>
                <select id="edit-sTime"></select>
            </div>
            <div>
                <label>結束時間</label>
                <select id="edit-eTime"></select>
            </div>
        </div>
        <div id="edit-free-slots" style="font-size:12px;color:var(--text-muted);margin-top:8px;"></div>
        <div class="modal-actions">
            <button class="btn-outline" onclick="closeEditModal()">取消</button>
            <button class="btn-confirm" onclick="confirmEdit()">確認修改</button>
        </div>
    </div>
</div>

<script>
const GAS_URL = "https://script.google.com/macros/s/AKfycbw1_8tKCkff3tftWqA7cYial1k26vhugn7BhGxISCQLBSmmyHzIAbMSjgG3iS_PpuF3/exec";
let currentUser = null;
let editTarget = null;  // { date, start, end, studentUser }
window.lessonRowsCache = [];

const DEFAULT_TOTAL_LESSONS = 30; // 若 Excel 沒填總時數，才用這個預設值
const WEEKDAY_TEXT = ['日', '一', '二', '三', '四', '五', '六'];

// ─── 日期工具：全部用本地日期，避免週六被時區轉成其他天 ───
function pad2(n) { return String(n).padStart(2, '0'); }
function makeLocalDate(dateStr) {
    const [y, m, d] = String(dateStr).split('-').map(Number);
    return new Date(y, m - 1, d);
}
function formatLocalDate(dateObj) {
    return dateObj.getFullYear() + '-' + pad2(dateObj.getMonth() + 1) + '-' + pad2(dateObj.getDate());
}
function todayString() { return formatLocalDate(new Date()); }
function addDays(date, days) {
    const d = makeLocalDate(date);
    d.setDate(d.getDate() + days);
    return formatLocalDate(d);
}
function getWeekday(dateStr) { return makeLocalDate(dateStr).getDay(); }

// ─── 清場不可預約時段 ───
// 每天 10:00–10:30；每週三、五 16:00–16:30
function getCleaningBreaks(date) {
    const weekday = getWeekday(date);
    const breaks = [
        { start: '10:00', end: '10:30', label: '清場' }
    ];
    if (weekday === 3 || weekday === 5) {
        breaks.push({ start: '16:00', end: '16:30', label: '清場' });
    }
    return breaks;
}
function overlaps(aStart, aEnd, bStart, bEnd) {
    return toMins(aStart) < toMins(bEnd) && toMins(aEnd) > toMins(bStart);
}
function overlapsCleaningBreak(date, start, end) {
    return getCleaningBreaks(date).some(b => overlaps(start, end, b.start, b.end));
}
function getCleaningText(date) {
    const weekday = WEEKDAY_TEXT[getWeekday(date)];
    return getCleaningBreaks(date).map(b => `週${weekday} ${b.start}–${b.end}`).join('、');
}

function getTotalLessons() {
    return Number(currentUser?.totalHours || currentUser?.totalLessons || currentUser?.purchased || currentUser?.hours || DEFAULT_TOTAL_LESSONS);
}
function getRemainingLessons() {
    return Number(currentUser?.hours ?? getTotalLessons());
}
function getUsedLessons() {
    return Math.max(0, getTotalLessons() - getRemainingLessons());
}
async function refreshCurrentUser() {
    try {
        const res = await fetch(`${GAS_URL}?type=getStudents`).then(r => r.json());
        const latest = res.find(s => String(s.user) === String(currentUser.user));
        if (latest) currentUser = { ...currentUser, ...latest };
    } catch (e) {
        console.warn('更新學員堂數失敗', e);
    }
}



// ─── 時間工具 ───
function toMins(t) {
    const [h, m] = t.split(':').map(Number);
    return h * 60 + m;
}
function fromMins(m) {
    return String(Math.floor(m / 60)).padStart(2, '0') + ':' + String(m % 60).padStart(2, '0');
}

/**
 * 核心演算法：計算自由區間
 * open: { start, end }  (e.g. 08:00~22:00)
 * booked: [{ start, end }]  (已被預約的區間)
 * return: [{ start, end }]  剩餘可用區間
 */
function calcFreeSlots(open, booked) {
    const openStart = toMins(open.start);
    const openEnd = toMins(open.end);

    // 只保留與 open 區間有交集的預約，並排序
    const merged = booked
        .map(b => ({ s: Math.max(toMins(b.start), openStart), e: Math.min(toMins(b.end), openEnd) }))
        .filter(b => b.s < b.e)
        .sort((a, b) => a.s - b.s);

    // 掃描空隙
    const free = [];
    let cursor = openStart;
    for (const b of merged) {
        if (cursor < b.s) free.push({ start: fromMins(cursor), end: fromMins(b.s) });
        cursor = Math.max(cursor, b.e);
    }
    if (cursor < openEnd) free.push({ start: fromMins(cursor), end: fromMins(openEnd) });
    return free;
}

// ─── 生成選項 ───
function genOptions(start, end, step = 30) {
    let opts = '';
    let cur = toMins(start);
    const stop = toMins(end);
    while (cur <= stop) {
        const t = fromMins(cur);
        opts += `<option value="${t}">${t}</option>`;
        cur += step;
    }
    return opts;
}

function genFreeOptions(freeSlots) {
    let opts = '';
    for (const seg of freeSlots) {
        let cur = toMins(seg.start);
        const stop = toMins(seg.end);
        while (cur <= stop) {
            const t = fromMins(cur);
            opts += `<option value="${t}">${t}</option>`;
            cur += 30;
        }
    }
    return opts;
}

