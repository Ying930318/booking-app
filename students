// ─── 載入可預約時段 ───
async function loadAvailableSlots() {
    const targetDate = document.getElementById('searchDate').value;
    if (!targetDate) return;

    const container = document.getElementById('available-slots');
    container.innerHTML = `<div class="loading"><span class="dot-anim">查詢時段中</span></div>`;

    const allSlots = await fetch(`${GAS_URL}?type=getSlots`).then(r => r.json());
    const daySlots = allSlots.filter(s => s.date === targetDate);
    const coachOpen = daySlots.find(s => s.status === 'open');
    const bookedSlots = daySlots.filter(s => s.status === 'pending' || s.status === 'confirmed');
    const cleaningBreaks = getCleaningBreaks(targetDate);
    const blockedSlots = [...bookedSlots, ...cleaningBreaks];

    if (!coachOpen) {
        container.innerHTML = `<div class="card" style="text-align:center;padding:30px;color:var(--text-muted);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:36px;height:36px;margin:0 auto 10px;display:block;opacity:0.4;"><circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            <div style="font-size:14px;">教練今日未開放時段</div>
            <div style="font-size:12px;margin-top:4px;">請選擇其他日期</div>
        </div>`;
        return;
    }

    const freeSlots = calcFreeSlots(coachOpen, blockedSlots);
    const totalFree = freeSlots.reduce((sum, s) => sum + toMins(s.end) - toMins(s.start), 0);

    // 時間軸視覺化
    const openStart = toMins(coachOpen.start);
    const openEnd = toMins(coachOpen.end);
    const total = openEnd - openStart;

    let timelineHTML = '';
    let cursor = openStart;
    const allSegments = [];
    const timelineBlocks = [
        ...bookedSlots.map(b => ({ ...b, blockType: 'booked' })),
        ...cleaningBreaks.map(b => ({ ...b, blockType: 'clean' }))
    ].sort((a, z) => toMins(a.start) - toMins(z.start));
    for (const b of timelineBlocks) {
        const bs = Math.max(toMins(b.start), openStart);
        const be = Math.min(toMins(b.end), openEnd);
        if (cursor < bs) allSegments.push({ type: 'free', s: cursor, e: bs });
        if (bs < be) allSegments.push({ type: b.blockType, s: bs, e: be, who: b.studentName || '' });
        cursor = Math.max(cursor, be);
    }
    if (cursor < openEnd) allSegments.push({ type: 'free', s: cursor, e: openEnd });

    for (const seg of allSegments) {
        const pct = ((seg.e - seg.s) / total * 100).toFixed(1);
        const label = `${fromMins(seg.s)}-${fromMins(seg.e)}`;
        if (seg.type === 'free') {
            timelineHTML += `<div class="timeline-free" style="width:${pct}%;" title="${label}">${pct > 15 ? label : ''}</div>`;
        } else if (seg.type === 'clean') {
            timelineHTML += `<div class="timeline-clean" style="width:${pct}%;" title="${label} 清場">${pct > 8 ? '清場' : ''}</div>`;
        } else {
            const isMine = seg.who === currentUser.name;
            timelineHTML += `<div class="timeline-booked" style="width:${pct}%;" title="${label} 已預約">${pct > 10 ? '已預約' : ''}</div>`;
        }
    }

    // 已預約清單
    let bookedListHTML = '';
    if (bookedSlots.length > 0) {
        bookedListHTML = `<div class="booked-section">
            <div style="font-size:12px;color:var(--text-muted);margin-bottom:8px;font-weight:700;">已預約時段</div>`;
        for (const b of bookedSlots.sort((a, z) => toMins(a.start) - toMins(z.start))) {
            const isMine = String(b.studentUser) === String(currentUser.user);
            bookedListHTML += `<div class="booked-item${isMine ? ' booked-mine' : ''}">
                <div class="booked-dot"></div>
                <div class="booked-time">${b.start} – ${b.end}</div>
                <div class="booked-who">${isMine ? '我的預約' : '已被預約'}</div>
            </div>`;
        }
        bookedListHTML += `</div>`;
    }

    const cleaningHTML = `<div class="booked-section">
        <div style="font-size:12px;color:var(--text-muted);margin-bottom:8px;font-weight:700;">不可預約時段</div>
        ${cleaningBreaks.map(b => `<div class="booked-item"><div class="booked-dot"></div><div class="booked-time">${b.start} – ${b.end}</div><div class="booked-who">清場</div></div>`).join('')}
    </div>`;

    // 預約表單
    let formHTML = '';
    if (freeSlots.length === 0) {
        formHTML = `<div style="text-align:center;padding:16px;color:var(--text-muted);font-size:13px;">今日所有時段均已預約</div>`;
    } else {
        const freeDesc = freeSlots.map(s => `${s.start}–${s.end}`).join('、');
        formHTML = `
            <div style="font-size:12px;color:var(--success);background:var(--success-bg);padding:8px 10px;border-radius:6px;margin-bottom:10px;font-weight:500;">
                可預約時段：${freeDesc}
            </div>
            <div class="slot-picker">
                <div>
                    <label>開始時間</label>
                    <select id="sTime">${genFreeOptions(freeSlots)}</select>
                </div>
                <div>
                    <label>結束時間</label>
                    <select id="eTime">${genFreeOptions(freeSlots)}</select>
                </div>
            </div>
            <button onclick="book('${targetDate}')" style="width:100%;padding:13px;background:var(--teal);color:white;border:none;border-radius:var(--radius-sm);font-family:'Noto Sans TC',sans-serif;font-size:15px;font-weight:700;cursor:pointer;">確認預約</button>`;
    }

    container.innerHTML = `
        <div class="card">
            <div class="card-title" style="margin-bottom:8px;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                教練開放時段
            </div>
            <div class="coach-range">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;flex-shrink:0;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                ${coachOpen.start} – ${coachOpen.end}（共 ${Math.round(total/60)} 小時）
            </div>
            <div class="timeline-wrap">
                <div class="timeline-label">時段使用狀況</div>
                <div class="timeline-bar">${timelineHTML}</div>
                <div class="time-axis">
                    <span>${coachOpen.start}</span>
                    <span style="color:var(--teal);font-size:9px;">▓ 可預約 ░ 已預約｜清場</span>
                    <span>${coachOpen.end}</span>
                </div>
            </div>
            ${bookedListHTML}
            ${cleaningHTML}
        </div>
        <div class="card">
            <div class="card-title" style="margin-bottom:10px;">選擇您的時段</div>
            ${formHTML}
        </div>`;
}

// ─── 預約 ───
function book(date) {
    const s = document.getElementById('sTime').value;
    const e = document.getElementById('eTime').value;
    if (toMins(s) >= toMins(e)) return showToast('結束時間需晚於開始時間');
    const duration = (toMins(e) - toMins(s)) / 60;
    if (duration < 0.5) return showToast('最少預約 0.5 小時');
    if (duration > getRemainingLessons()) return showToast('剩餘時數不足，無法預約');
    if (overlapsCleaningBreak(date, s, e)) return showToast('此時段遇到清場時間，不能預約');
    fetch(GAS_URL, {
        method: 'POST',
        mode: 'no-cors',
        body: JSON.stringify({ type: 'bookSlot', date, start: s, end: e, studentName: currentUser.name, studentUser: currentUser.user })
    }).then(() => {
        showToast('預約已送出！等待教練確認');
        showPage('my');
    });
}




function normalizeAppointment(a) {
    const timeText = a.time || a.timeRange || '';
    let start = a.start || '';
    let end = a.end || '';
    if ((!start || !end) && timeText.includes('-')) {
        const parts = timeText.split('-').map(x => x.trim());
        start = start || parts[0];
        end = end || parts[1];
    }
    return {
        date: a.date,
        start,
        end,
        status: a.status || 'pending',
        studentName: a.studentName || a.name || '',
        studentUser: a.studentUser || a.user || '',
        lessonNo: a.lessonNo || a.no || '',
        remainingAfter: a.remainingAfter ?? ''
    };
}

function appointmentKey(x) {
    return `${x.date}|${x.start}|${x.studentUser || currentUser.user}`;
}

async function loadMyAppointments() {
    const merged = new Map();

    try {
        const appts = await fetch(`${GAS_URL}?type=getAppointments&studentUser=${encodeURIComponent(currentUser.user)}`).then(r => r.json());
        appts.map(normalizeAppointment).forEach(a => merged.set(appointmentKey(a), a));
    } catch (e) {
        console.warn('讀取 appointments 失敗', e);
    }

    // 兼容舊資料：如果以前 confirmed 只存在 slots，還是把它合併進「我的課程」
    try {
        const slots = await fetch(`${GAS_URL}?type=getSlots`).then(r => r.json());
        slots.filter(s => String(s.studentUser) === String(currentUser.user))
            .map(normalizeAppointment)
            .forEach(s => {
                const key = appointmentKey(s);
                if (!merged.has(key)) merged.set(key, s);
            });
    } catch (e) {
        console.warn('讀取 slots 失敗', e);
    }

    return Array.from(merged.values())
        .filter(a => String(a.studentUser) === String(currentUser.user) || !a.studentUser)
        .filter(a => a.status !== 'cancelled')
        .sort((a, b) => (a.date + a.start).localeCompare(b.date + b.start));
}

function statusText(status) {
    if (status === 'pending') return '待確認';
    if (status === 'confirmed') return '已確認';
    if (status === 'completed') return '已完成';
    if (status === 'cancelled') return '已取消';
    return status || '未預約';
}
function statusBadgeClass(status) {
    if (status === 'pending') return 'badge-pending';
    if (status === 'confirmed' || status === 'completed') return 'badge-confirmed';
    return '';
}
function canModifyLesson(item) {
    if (!item || item.empty) return false;
    if (item.status !== 'pending' && item.status !== 'confirmed') return false;
    const lessonStart = new Date(`${item.date}T${item.start}:00+08:00`);
    return lessonStart > new Date();
}

function buildLessonRows(records) {
    const total = getTotalLessons();
    const booked = records.filter(r => r.status !== 'cancelled');
    const rows = [];
    for (let i = 0; i < total; i++) {
        const r = booked[i];
        rows.push(r ? { ...r, displayNo: i + 1, empty: false } : { displayNo: i + 1, empty: true, status: 'empty' });
    }
    return rows;
}

function renderLessonSummary(records) {
    const total = getTotalLessons();
    const remaining = getRemainingLessons();
    const completedHours = Math.max(0, total - remaining);
    const pending = records.filter(s => s.status === 'pending').length;
    const confirmedFuture = records.filter(s => s.status === 'confirmed').length;

    document.getElementById('user-chip').textContent = `${currentUser.name} · 剩餘 ${remaining} 堂課`;

    document.getElementById('lesson-summary').innerHTML = `
        <div class="lesson-summary" style="grid-template-columns: repeat(3, 1fr);">
            <div class="lesson-pill"><strong>${total}</strong><span>我的課程</span></div>
            <div class="lesson-pill"><strong>${completedHours}</strong><span>已完成課程</span></div>
            <div class="lesson-pill"><strong>${remaining}</strong><span>剩餘課程</span></div>
        </div>`;
}

function renderLessonList(records) {
    const total = getTotalLessons();
    const rows = buildLessonRows(records);
    window.lessonRowsCache = rows;

    const html = rows.map((item, idx) => {
        if (item.empty) {
            return `<div class="lesson-row lesson-empty" onclick="openLessonDetail(${idx})">
                <div class="lesson-no">第${item.displayNo}筆</div>
                <div>
                    <div class="lesson-main">尚未預約</div>
                    <div class="lesson-sub">點擊後可查看狀態</div>
                </div>
                <span class="badge" style="background:#eef3f4;color:var(--text-muted);">空堂</span>
            </div>`;
        }

        const sub = item.status === 'completed'
            ? `已完成`
            : item.status === 'confirmed'
                ? '課程已確認，如需更改請私訊教練'
                : '等待教練確認中...';

        return `<div class="lesson-row" onclick="openLessonDetail(${idx})">
            <div class="lesson-no">第${item.displayNo}堂</div>
            <div>
                <div class="lesson-main">${item.date}　${item.start} – ${item.end}</div>
                <div class="lesson-sub">${sub}</div>
            </div>
            <span class="badge ${statusBadgeClass(item.status)}">${statusText(item.status)}</span>
        </div>`;
    }).join('');

    document.getElementById('lesson-table').innerHTML = `
        <div class="card">
            <div class="card-title">課程預約紀錄</div>
            <div class="lesson-list">${html}</div>
            <div class="helper-text">如需取消或改時段，請點擊課程明細。</div>
        </div>`;
}

function openLessonDetail(index) {
    const item = window.lessonRowsCache[index];
    if (!item) return;
    document.getElementById('lesson-detail-title').textContent = `第${item.displayNo}筆課`;

    if (item.empty) {
        document.getElementById('lesson-detail-body').innerHTML = `
            <div class="detail-line"><strong>狀態：</strong>尚未預約</div>
            <div class="detail-line">請回到「預約課程」選擇日期與時段。</div>`;
        document.getElementById('lesson-detail-actions').innerHTML = `<button class="btn-outline" onclick="closeLessonDetail()">關閉</button>`;
    } else {
        document.getElementById('lesson-detail-body').innerHTML = `
            <div class="detail-line"><strong>日期：</strong>${item.date}</div>
            <div class="detail-line"><strong>時間：</strong>${item.start} – ${item.end}</div>
            <div class="detail-line"><strong>狀態：</strong>${statusText(item.status)}</div>`;

        if (canModifyLesson(item)) {
            document.getElementById('lesson-detail-actions').innerHTML = `
                <button class="btn-outline" onclick="closeLessonDetail()">關閉</button>
                <button class="btn-confirm" onclick="editLessonFromDetail(${index})">改時段</button>
                <button class="btn-danger-fill" onclick="cancelLessonFromDetail(${index})">取消</button>`;
        } else {
            document.getElementById('lesson-detail-actions').innerHTML = `<button class="btn-outline" onclick="closeLessonDetail()">關閉</button>`;
        }
    }
    document.getElementById('lesson-detail-modal').classList.add('show');
}

function closeLessonDetail() {
    document.getElementById('lesson-detail-modal').classList.remove('show');
}

function editLessonFromDetail(index) {
    const item = window.lessonRowsCache[index];
    closeLessonDetail();
    openEditModal(item.date, item.start, item.end);
}

function cancelLessonFromDetail(index) {
    const item = window.lessonRowsCache[index];
    closeLessonDetail();
    cancelBooking(item.date, item.start);
}

// ─── 我的課程 ───
async function loadMySlots() {
    document.getElementById('lesson-summary').innerHTML = '';
    document.getElementById('lesson-table').innerHTML = `<div class="loading"><span class="dot-anim">載入中</span></div>`;

    // 嘗試觸發後端自動結案：已確認且結束時間已過的課程，才會扣堂
    try {
        fetch(GAS_URL, { method: 'POST', mode: 'no-cors', body: JSON.stringify({ type: 'completePastLessons' }) });
    } catch (e) {}

    await refreshCurrentUser();
    const records = await loadMyAppointments();
    renderLessonSummary(records);
    renderLessonList(records);
}

// ─── 取消 ───
function cancelBooking(date, start) {
    if (!confirm('確定要取消此預約？')) return;
    fetch(GAS_URL, {
        method: 'POST',
        mode: 'no-cors',
        body: JSON.stringify({ type: 'cancelSlot', date, start, studentUser: currentUser.user })
    }).then(() => {
        showToast('預約已取消');
        loadMySlots();
    });
}

// ─── 修改 Modal ───
async function openEditModal(date, start, end) {
    editTarget = { date, start, end };
    document.getElementById('edit-date-label').textContent = `日期：${date}`;

    // 取得當天空閒時段（不含自己這筆）
    const allSlots = await fetch(`${GAS_URL}?type=getSlots`).then(r => r.json());
    const daySlots = allSlots.filter(s => s.date === date);
    const coachOpen = daySlots.find(s => s.status === 'open');
    const otherBooked = daySlots.filter(s =>
        (s.status === 'pending' || s.status === 'confirmed') &&
        !(String(s.studentUser) === String(currentUser.user) && s.start === start)
    );
    const cleaningBreaks = getCleaningBreaks(date);

    if (!coachOpen) { showToast('找不到該日期的教練時段'); return; }

    const freeSlots = calcFreeSlots(coachOpen, [...otherBooked, ...cleaningBreaks]);
    // 加回自己這筆
    const withSelf = calcFreeSlots(coachOpen, otherBooked);  // already excludes self

    const freeDesc = freeSlots.length > 0
        ? '可選時段：' + freeSlots.map(s => `${s.start}–${s.end}`).join('、')
        : '無其他可用時段';
    document.getElementById('edit-free-slots').textContent = `${freeDesc}｜清場不可約：${getCleaningText(date)}`;
    document.getElementById('edit-sTime').innerHTML = genFreeOptions(freeSlots);
    document.getElementById('edit-eTime').innerHTML = genFreeOptions(freeSlots);

    // 預設選中原本時間
    const sOpts = document.getElementById('edit-sTime').options;
    const eOpts = document.getElementById('edit-eTime').options;
    for (let i = 0; i < sOpts.length; i++) if (sOpts[i].value === start) sOpts[i].selected = true;
    for (let i = 0; i < eOpts.length; i++) if (eOpts[i].value === end) eOpts[i].selected = true;

    document.getElementById('edit-modal').classList.add('show');
}

function closeEditModal() {
    document.getElementById('edit-modal').classList.remove('show');
    editTarget = null;
}

function confirmEdit() {
    const s = document.getElementById('edit-sTime').value;
    const e = document.getElementById('edit-eTime').value;
    if (toMins(s) >= toMins(e)) return showToast('結束時間需晚於開始時間');
    const duration = (toMins(e) - toMins(s)) / 60;
    if (duration < 0.5) return showToast('最少預約 0.5 小時');
    if (duration > getRemainingLessons()) return showToast('剩餘時數不足，無法修改為此時長');
    if (overlapsCleaningBreak(editTarget.date, s, e)) return showToast('此時段遇到清場時間，不能預約');

    // 先取消舊的，再新增新的
    fetch(GAS_URL, {
        method: 'POST', mode: 'no-cors',
        body: JSON.stringify({ type: 'cancelSlot', date: editTarget.date, start: editTarget.start, studentUser: currentUser.user })
    }).then(() => {
        fetch(GAS_URL, {
            method: 'POST', mode: 'no-cors',
            body: JSON.stringify({ type: 'bookSlot', date: editTarget.date, start: s, end: e, studentName: currentUser.name, studentUser: currentUser.user })
        }).then(() => {
            showToast('預約已修改！等待教練確認中...');
            closeEditModal();
            loadMySlots();
        });
    });
}
</script>
